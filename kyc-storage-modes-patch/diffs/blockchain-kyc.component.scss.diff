+
+/* KYC storage mode refresh */
+.storage-mode-card {
+  border-top: 4px solid #00539f;
+}
+
+.storage-options {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(220px, 1fr));
+  gap: 16px;
+}
+
+.storage-option {
+  position: relative;
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+  min-height: 130px;
+  padding: 18px;
+  border: 2px solid #d9e2ec;
+  border-radius: 12px;
+  background: #ffffff;
+  cursor: pointer;
+  transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
+
+  &:hover {
+    transform: translateY(-1px);
+    border-color: #7fb3e1;
+    box-shadow: 0 8px 18px rgba(16, 42, 67, 0.08);
+  }
+
+  &.selected {
+    border-color: #00539f;
+    background: #eef6ff;
+    box-shadow: 0 0 0 3px rgba(0, 83, 159, 0.1);
+  }
+
+  &.recommended {
+    em {
+      position: absolute;
+      top: 10px;
+      right: 10px;
+      padding: 4px 8px;
+      border-radius: 999px;
+      background: #e3f9e5;
+      color: #0f7b3e;
+      font-size: 10px;
+      font-style: normal;
+      font-weight: 800;
+      text-transform: uppercase;
+    }
+  }
+
+  input[type='radio'] {
+    width: 18px;
+    height: 18px;
+    margin-top: 2px;
+    accent-color: #00539f;
+  }
+}
+
+.storage-option-content {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+
+  strong {
+    color: #003b7a;
+    font-size: 15px;
+  }
+
+  small {
+    color: #52616b;
+    font-size: 12px;
+    line-height: 1.5;
+  }
+}
+
+.mode-warning {
+  margin-top: 16px;
+  padding: 12px 14px;
+  border: 1px solid #f2c94c;
+  border-radius: 9px;
+  background: #fff8db;
+  color: #7a5d00;
+  font-size: 12px;
+  font-weight: 700;
+  line-height: 1.5;
+}
+
+.mode-status-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(140px, 1fr));
+  gap: 12px;
+  margin: 18px 0;
+}
+
+.mode-status-item {
+  padding: 12px;
+  border: 1px solid #d9e2ec;
+  border-radius: 9px;
+  background: #f7faff;
+
+  span,
+  strong {
+    display: block;
+  }
+
+  span {
+    margin-bottom: 5px;
+    color: #6b7c93;
+    font-size: 11px;
+    font-weight: 700;
+    text-transform: uppercase;
+  }
+
+  strong {
+    color: #7a1f1f;
+    font-size: 12px;
+  }
+
+  strong.status-ok {
+    color: #0f7b3e;
+  }
+}
+
+@media (max-width: 992px) {
+  .storage-options,
+  .mode-status-grid {
+    grid-template-columns: 1fr;
+  }
+}
