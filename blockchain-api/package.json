{
  "name": "blockchain-api",
  "version": "1.0.0",
  "description": "Blockchain API Middleware for Hyperledger Fabric integration",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "fabric:import-admin": "node scripts/import-admin-identity.js",
    "fabric:test": "node scripts/test-fabric-connection.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [
    "blockchain",
    "hyperledger-fabric",
    "express",
    "nodejs",
    "api-middleware"
  ],
  "author": "Nix",
  "license": "MIT",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.64.0",
    "@grpc/grpc-js": "^1.14.3",
    "@hyperledger/fabric-gateway": "^1.10.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.0",
    "express-validator": "^7.3.2",
    "grpc": "^1.24.11",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^18.1.2",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "uuid": "^13.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
