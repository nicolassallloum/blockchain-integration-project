{
  "name": "blockchain-api",
  "version": "1.0.0",
  "description": "Blockchain API Middleware for Hyperledger Fabric integration",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [
    "blockchain",
    "hyperledger-fabric",
    "express",
    "nodejs",
    "api-middleware"
  ],
  "author": "Nix",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
