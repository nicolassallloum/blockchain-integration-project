NODE_ENV=development
APP_NAME=Blockchain API Middleware
APP_VERSION=1.0.0

HOST=0.0.0.0
PORT=3001

API_PREFIX=/api/v1

CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

FABRIC_CHANNEL_NAME=kycchannelnix1
FABRIC_CHAINCODE_NAME=kyc-wallet-chaincode-js
FABRIC_MSP_ID=Org1MSP
FABRIC_WALLET_PATH=/path/to/fabric/wallet
FABRIC_CONNECTION_PROFILE=/path/to/connection-profile.json

LOG_LEVEL=info
LOG_TO_FILE=true
